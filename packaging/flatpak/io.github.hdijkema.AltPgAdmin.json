{
  "app-id": "io.github.hdijkema.AltPgAdmin",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "pgadmin_qt",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=host",
    "--filesystem=/run/postgresql",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.kwalletd6"
  ],
  "cleanup": [
    "/include",
    "/lib/*.a",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/man",
    "/mkspecs"
  ],
  "modules": [
    {
      "name": "postgresql-client",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app --with-ssl=openssl --without-readline --without-icu --without-zlib --without-lz4 --without-zstd",
        "make -j${FLATPAK_BUILDER_N_JOBS}",
        "make -C src/interfaces/libpq install",
        "make -C src/include install",
        "make -C src/bin/pg_config install",
        "make -C src/bin/pg_dump install",
        "make -C src/bin/psql install",
        "make -C src/bin/scripts install",
        "install -Dm644 COPYRIGHT /app/share/doc/postgresql/COPYRIGHT"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ftp.postgresql.org/pub/source/v18.6/postgresql-18.6.tar.bz2",
          "sha256": "555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f"
        }
      ]
    },
    {
      "name": "alt-pg-admin",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPGADM_BUILD_TESTS=OFF",
        "-DFETCHCONTENT_FULLY_DISCONNECTED=ON",
        "-DFETCHCONTENT_SOURCE_DIR_QTKEYCHAIN=/run/build/alt-pg-admin/vendor/qtkeychain",
        "-DFETCHCONTENT_SOURCE_DIR_ZLIB=/run/build/alt-pg-admin/vendor/zlib",
        "-DFETCHCONTENT_SOURCE_DIR_LIBXLSXWRITER=/run/build/alt-pg-admin/vendor/libxlsxwriter"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "build",
            "dist",
            ".flatpak-builder"
          ]
        },
        {
          "type": "archive",
          "url": "https://github.com/frankosterfeld/qtkeychain/archive/refs/tags/0.17.0.tar.gz",
          "sha256": "3b85c3929034b0a99da777130c34d99f006fcd3a9d56564159399a33fee0e504",
          "dest": "vendor/qtkeychain"
        },
        {
          "type": "archive",
          "url": "https://github.com/madler/zlib/archive/refs/tags/v1.3.2.tar.gz",
          "sha256": "b99a0b86c0ba9360ec7e78c4f1e43b1cbdf1e6936c8fa0f6835c0cd694a495a1",
          "dest": "vendor/zlib"
        },
        {
          "type": "archive",
          "url": "https://github.com/jmcnamara/libxlsxwriter/archive/refs/tags/v1.2.4.tar.gz",
          "sha256": "e0db59fc248a5ffa465a05ea83a9d466d4bca0e53ab42771515d4ebb467a41c1",
          "dest": "vendor/libxlsxwriter"
        }
      ],
      "no-make-install": true,
      "post-install": [
        "cmake --install . --component Runtime"
      ]
    }
  ]
}